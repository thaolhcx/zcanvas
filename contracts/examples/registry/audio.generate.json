{
  "type": "audio.generate", "version": 2, "title": "Generate audio", "category": "audio",
  "description": "Speech from a script.",
  "inputs": [{ "key": "text", "kind": "text", "multiple": true, "label": "Script" }],
  "outputs": [{ "key": "audio", "kind": "audio" }],
  "params": {
    "model": { "type": "model", "kind": "audio", "default": "auto", "label": "Model" },
    "prompt": { "type": "string", "multiline": true, "label": "Text", "placeholder": "Input the text to speak" },
    "autoPrompt": { "type": "boolean", "default": true, "label": "Auto prompt", "help": "An LLM fixes punctuation and pauses for speech; the words stay the same", "advanced": true }
  },
  "runner": { "kind": "job", "worker": "audio-gen", "timeoutSec": 300, "concurrency": 4 },
  "cost": { "unit": "credit_per_1k_chars", "estimate": 0.5 },
  "migrate": "contracts/migrate.ts"
}
