DATABASE_URL=postgres://zcanvas:zcanvas@127.0.0.1:55432/zcanvas
API_PORT=4310
SYNC_PORT=4311
PUBLIC_API_URL=http://127.0.0.1:4310
# 1 = every model answers with fixtures (through the same queue). 0 = real providers.
MOCK_WORKERS=1
# BytePlus ModelArk (MOCK_WORKERS=0). Keys live only here (.env.local), never in commits or logs.
BYTEPLUS_API_KEY=
# BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# Seed Audio (speech) has its own key on the Voice console.
BYTEPLUS_VOICE_API_KEY=
# BYTEPLUS_VOICE_BASE_URL=https://voice.ap-southeast-1.bytepluses.com
# TOS + Assets (references by URL, real-person references as asset://). All three turn it on.
BYTEPLUS_ACCESS_KEY=
BYTEPLUS_SECRET_KEY=
BYTEPLUS_TOS_BUCKET=
# BYTEPLUS_TOS_REGION=ap-southeast-1
# BYTEPLUS_TOS_ENDPOINT=https://tos-s3-ap-southeast-1.bytepluses.com
# BYTEPLUS_TOS_PREFIX=zcanvas/byteplus
# verify (default) | lazy | always | off
# BYTEPLUS_ASSET_MODE=verify
# BYTEPLUS_ASSET_GROUP_ID=
# BYTEPLUS_VERIFY_MODEL=seed-2-0-pro-260328
# Account endpoints, "id" or "id|Name", comma-separated (e.g. Seedance 2.0 / Fast / Mini, Seedream Lite).
# BYTEPLUS_LANGUAGE_MODELS=
# BYTEPLUS_IMAGE_MODELS=
# BYTEPLUS_VIDEO_MODELS=
# Public base URL of this API for provider callbacks (optional; the scheduled fetch works without it).
# PROVIDER_CALLBACK_BASE_URL=
# Running model jobs one user may have at once.
# GEN_USER_MAX=8
# The single identity of this local POC (no login). Clients cannot override it.
ZCANVAS_ACTOR_ID=usr_local

# Storage: "local" (default, no MinIO needed) or "s3" (MinIO or any S3-compatible store).
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=.data/assets
# S3 profile. Assets uploaded before the catalog live here, so keep it configured
# (S3_LEGACY_READ=0 turns off reading it when there are no legacy assets).
S3_ENDPOINT=http://127.0.0.1:59000
S3_BUCKET=zcanvas
S3_REGION=us-east-1
S3_ACCESS_KEY=zcanvas
S3_SECRET_KEY=zcanvas-local-only
S3_FORCE_PATH_STYLE=1
# Local MinIO only. Production buckets are provisioned, not created by the app.
S3_AUTO_CREATE_BUCKET=1
MAX_UPLOAD_BYTES=104857600
ASSET_CLEANUP_DELAY_SEC=3600

# Semantic search: none | hash (tests only) | local (in-process model) | openai (any compatible API)
SEARCH_SEMANTIC=1
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_DIMS=384
# EMBEDDING_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
